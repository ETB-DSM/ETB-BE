# Server
SERVER_PORT=8080          # 컨테이너 내부 포트 (Go 서버 bind)
SERVER_EXTERNAL_PORT=8082 # 호스트 노출 포트 (docker-compose ports 좌측)

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=aicane
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAY=7

# Resend (이메일 발송)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@heijionline.com

# Google OAuth
GOOGLE_CLIENT_ID=

# Email Verification
EMAIL_CODE_EXPIRE_MIN=5

# Cloudflare Tunnel
TUNNEL_TOKEN=